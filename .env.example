# Variables de entorno del backend de PanelVault.
# Este archivo es SOLO documentacion: Spring no lo lee. Los valores reales se
# configuran como variables de entorno del sistema (en local) o en Render
# (en produccion). Nunca escribas aqui valores reales.

# --- Base de datos ---
PANELVAULT_DB_URL=jdbc:postgresql://localhost:5432/panelvault_dev
PANELVAULT_DB_USER=panelvault
PANELVAULT_DB_PASSWORD=

# --- Tokens JWT ---
# Clave HMAC en Base64, minimo 32 bytes. Generala con un generador aleatorio;
# nunca reutilices la de otro entorno.
PANELVAULT_JWT_SECRET=
# Emisor de los tokens (claim iss). Debe ser una URL; en produccion, la del backend.
PANELVAULT_JWT_ISSUER=http://localhost:9096

# --- Verificacion en dos pasos (2FA) ---
# Clave AES-256 en Base64, exactamente 32 bytes, para cifrar los secretos TOTP.
# Si se pierde, las 2FA ya activadas dejan de funcionar: guardala con cuidado.
PANELVAULT_TOTP_ENCRYPTION_KEY=

# --- Motor de IA ---
# URL del motor (en local corre en el puerto 8001; en produccion, la de Render).
PANELVAULT_ENGINE_URL=http://localhost:8001
# Secreto HMAC compartido con el motor: minimo 32 caracteres y el MISMO valor en
# ambos servicios.
PANELVAULT_ENGINE_SECRET=
# true para que el backend procese la cola de analisis.
PANELVAULT_ANALYSIS_WORKER_ENABLED=true

# --- Capa de borde (Edge/Gateway) ---
# true en produccion: el backend solo acepta peticiones firmadas por el servidor de Next.js.
PANELVAULT_GATEWAY_ENABLED=false
# Secreto HMAC compartido con el frontend (minimo 32 caracteres). Mismo valor en ambos.
PANELVAULT_GATEWAY_SECRET=
# Origenes de navegador permitidos (CORS), separados por comas.
PANELVAULT_CORS_ORIGINS=http://localhost:3000

# --- Servidor ---
PORT=9096
