# Variables de entorno del backend de PanelVault.
# Este archivo es solo documentacion: NUNCA pongas aqui valores reales.
# En local se configuran en IntelliJ (Run > Edit Configurations > Environment variables);
# en produccion, en el panel de Render.

# Conexion a PostgreSQL (los dos primeros tienen valor por defecto para desarrollo local).
PANELVAULT_DB_URL=jdbc:postgresql://localhost:5432/panelvault_dev
PANELVAULT_DB_USER=panelvault
PANELVAULT_DB_PASSWORD=

# Puerto HTTP. En local, 9096 por defecto; Render lo asigna automaticamente.
PORT=9096